OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_VERIFY_SSL=true
SUPERVISOR_MAX_STEPS=8
RECURSION_LIMIT=30

RAG_BACKEND=local
RAG_DATA_DIR=data/knowledge
RAG_INDEX_PATH=state/rag-index.json
RAG_TOP_K=5
RAG_CANDIDATE_K=15
RAG_CHUNK_SIZE=700
RAG_CHUNK_OVERLAP=100
RAG_SEMANTIC_WEIGHT=0.6
RAG_LEXICAL_WEIGHT=0.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
PINECONE_API_KEY=
PINECONE_INDEX_NAME=incident-intelligence
PINECONE_NAMESPACE=technical-knowledge
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

REDIS_URL=redis://localhost:6379
JOB_TTL_SECONDS=86400
JOB_QUEUE_SIZE=100
WORKER_COUNT=2

PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=incident-intelligence-system
PHOENIX_ENABLED=true
